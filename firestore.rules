rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == "admin" ||
        request.auth.uid == "nz5qAUHfP2OKIcPF4DqidBz2sQC2" ||
        request.auth.uid == "yZzLNGTfEHeGT6cBKkspxb8H1SG3" ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == "naushadabdul2006@gmail.com" ||
          request.auth.token.email.lower() == "admin@neuralinks.club"
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & student directory
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isOwner(userId);

      match /{allSubcollections=**} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isOwner(userId);
      }
    }

    // Uploaded files
    match /files/{fileId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Student Submissions
    match /submissions/{submissionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
    }

    // CMS & Learning Content
    match /levels/{levelId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /tools/{toolId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /roadmapNodes/{nodeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Fallback rule for any other collection
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}

