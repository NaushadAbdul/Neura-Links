rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin user ID check for nz5qAUHfP2OKIcPF4DqidBz2sQC2
    function isAdmin() {
      return isAuthenticated() && request.auth.uid == "nz5qAUHfP2OKIcPF4DqidBz2sQC2";
    }

    // Admin has complete read/write access across all storage paths.
    // Standard users are locked down to their own folder path /users/{userId}/*
    match /users/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Default rule for all other storage paths
    match /{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
